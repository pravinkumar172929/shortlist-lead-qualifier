# Everything here is optional. With no variables set, the app runs with an
# in-memory cache and rule-based openers.

# Supabase (Postgres) for a cache shared across serverless instances.
# Create the table with supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI-written "why call" notes and openers.
ANTHROPIC_API_KEY=
